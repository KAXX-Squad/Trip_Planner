# ============================================
# 项目统一环境配置示例文件
# 复制此文件为 .env 并填入真实的密钥值
# ============================================

# ============================================
# Backend 配置
# ============================================

# --------------------------------------------
# LLM 配置 - 支持多 API 轮询/故障转移
# --------------------------------------------
# 主 LLM 配置
LLM_MODEL_ID="qwen3.6-flash"
LLM_API_KEY="your-api-key-here"
LLM_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"

# 备用 LLM 1 配置 (可选，用于故障转移)
LLM_API_KEY_2="your-api-key-2-here"
LLM_BASE_URL_2="https://api-inference.modelscope.cn/v1/"
LLM_MODEL_2="ZhipuAI/GLM-4.7-Flash"

# 备用 LLM 2 配置 (可选，用于故障转移)
LLM_API_KEY_3="your-api-key-3-here"
LLM_BASE_URL_3="https://api.deepseek.com"
LLM_MODEL_3="deepseek-v4-flash"

# LLM 超时配置
LLM_TIMEOUT=60              # 请求超时时间 (秒)
LLM_MAX_RETRIES=3           # 最大重试次数
LLM_RETRY_DELAY=2           # 重试延迟 (秒)

# --------------------------------------------
# 服务器配置
# --------------------------------------------
HOST=0.0.0.0
PORT=8000

# --------------------------------------------
# CORS 配置
# --------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
LOG_LEVEL=INFO

# --------------------------------------------
# 第三方 API 配置
# --------------------------------------------
# Unsplash API Credentials
UNSPLASH_ACCESS_KEY="your-unsplash-access-key-here"
UNSPLASH_SECRET_KEY="your-unsplash-secret-key-here"

# 高德地图 API 配置 (Backend)
AMAP_API_KEY=your-amap-api-key-here

# ============================================
# Frontend 配置
# ============================================

# 后端 API 地址
VITE_API_BASE_URL=http://localhost:8000

# 高德地图 Web API Key
VITE_AMAP_WEB_KEY=your-amap-web-key-here

# 高德地图 Web 端 JS API Key
VITE_AMAP_WEB_JS_KEY=your-amap-web-js-key-here

# ============================================
# 配置说明
# ============================================
# 1. 复制此文件：cp .env.example .env (Linux/Mac) 或 copy .env.example .env (Windows)
# 2. 将所有 "your-xxx-here" 替换为真实的密钥值
# 3. .env 文件应添加到 .gitignore 中，不要提交到版本控制
# 4. 前端配置需要添加 VITE_ 前缀才能被 Vite 识别
# ============================================
